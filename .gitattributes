# 기본: 레거시 895개 HTML/CSS/JS 컨벤션에 맞춰 CRLF로 통일.
# (git의 core.autocrlf는 로컬/팀원마다 설정이 달라질 수 있어, SVN 때 겪었던
#  "줄바꿈 차이로 전체 diff" 문제가 git에서도 재현될 수 있다. .gitattributes로
#  명시해서 로컬 설정과 무관하게 항상 동일하게 유지한다.)
* text=auto eol=crlf

# node 툴링 파일은 생태계 관행대로 LF 유지
project/package.json text eol=lf
project/package-lock.json text eol=lf
project/gulpfile.js text eol=lf
project/.nvmrc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 바이너리 (diff 대상/EOL 변환 대상에서 제외)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
